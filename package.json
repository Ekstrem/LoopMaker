{
  "name": "dsh-loopmaker",
  "version": "0.2.0",
  "description": "DSH plugin: доставляет сообщения из outbox-чата петли в сессию адресата и тем самым оживляет её",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "loopmaker",
    "multi-agent"
  ],
  "homepage": "https://github.com/Ekstrem/LoopMaker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ekstrem/LoopMaker.git"
  },
  "author": "Ekstrem",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./parse": "./lib/parse.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "license": "MIT"
}
